# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
coverage.json
htmlcov/
.tox/

# Linting / Type-checking caches
.mypy_cache/
.ruff_cache/

# Environment
.env
.env.*
!.env.example

# Secrets
*.pem
*.key
secrets.json
# NOTE: .secrets.baseline is intentionally tracked — it is referenced by the
# detect-secrets hook in .pre-commit-config.yaml and must ship with the repo.
# Do not add it back to .gitignore.

# OS
.DS_Store
Thumbs.db

# Build
*.so
*.dylib
*.whl

# Temporary diff/patch files
*.diff
current_diff.patch
diff-code.txt

# Local scratch/verification workspaces
.scratch-*/

# Sandbox config (may contain API keys)
~/.sbox/

# Benchmarks output
benchmarks/*.log

# Process artifacts (evidence snapshots & research notes)
# NOTE: .agents/notes/ (ADR decisions) is NOT ignored — it stays tracked.
# NOTE: .agents/design/ is deprecated (historical artifacts tracked, no new content).
/.agents/evidence/
/.agents/research/

# awesome-templates sub-repo (has its own git)
awesome-templates/
